# =============================================================================
# HUNTFLOW — Canonical Environment Template
# Copy this file to .env: cp .env.example .env
# Never commit real credentials or secret keys to git.
# =============================================================================

# ── Core Runtime & Storage Paths ─────────────────────────────────────────────
# Local directory where SQLite database (huntflow.db) and evidence artifacts live.
HUNTFLOW_DATA_DIR=data
HUNTFLOW_DB_PATH=
NEXT_PUBLIC_DISABLE_REACT_DEVTOOLS=

# ── Scrapling Python Sidecar Agent ───────────────────────────────────────────
# Base URL for the Scrapling FastAPI sidecar (default: http://127.0.0.1:8001)
SCRAPLING_AGENT_URL=http://127.0.0.1:8001
# Shared auth token between Next.js and Python sidecar.
# Required if sidecar is running in production or Docker profile.
HUNTFLOW_AGENT_TOKEN=
# Global worker concurrency cap for sidecar crawling (1-16, default: 1)
HUNTFLOW_CRAWL_CONCURRENCY=1

# ── Crawler Connector Keys (Optional API Keys for Aggregators) ───────────────
# Zero-key feeds (Greenhouse, Lever, Ashby, Personio, Arbeitnow, Jobicy, Remotive,
# Himalayas, ReliefWeb) work out-of-the-box without keys.
# The following optional keys activate higher-volume aggregator APIs:
# The Muse API Key (https://www.themuse.com/developers/api/v2)
THEMUSE_API_KEY=
# Adzuna Developer Application ID & Key (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble Search API Key (https://jooble.org/api/about)
JOOBLE_API_KEY=
# Findwork.dev Developer Token (https://findwork.dev/developers/)
FINDWORK_API_KEY=
# USAJobs Authorization Key & User-Agent (https://developer.usajobs.gov/)
USAJOBS_AUTH_KEY=
USAJOBS_USER_AGENT=

# ── LLM Providers (Optional for Generation, Scoring & Tailoring) ─────────────
# Default active provider: openrouter | gemini | anthropic | openai | groq | deepseek | ollama
HUNTFLOW_PROVIDER=
# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq (https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Local Ollama (offline RAG & generation, default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Gmail OAuth & IMAP (Optional Email Follow-Up Integration) ────────────────
# Google Cloud OAuth 2.0 Client credentials with scope https://mail.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# ── Cloudinary CDN (Optional for Browser Screenshot Persistence) ─────────────
# If left blank, agent screenshots remain stored locally in .agent_runs/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Observability & Tracing (Optional) ───────────────────────────────────────
# LangSmith tracing (SaaS)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=huntflow
# OpenTelemetry OTLP Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
