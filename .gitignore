# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local database + agent artifacts
/data/
/scrapling-agent/.venv/
/scrapling-agent/.agent_runs/
/scrapling-agent/.linkedin_session/
/scrapling-agent/*.log
/scrapling-agent/.agent_runs
/scrapling-agent/__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# local claude settings (machine-specific)
.claude/settings.local.json
.claude/worktrees/
session-export-*/
